{
  "name": "homebridge-roborock-vacuum",
  "displayName": "Homebridge Roborock Vacuum",
  "version": "2.2.11",
  "description": "Homebridge plugin that brings Roborock robot vacuums to Apple Home over HomeKit or Matter, with local control on your network.",
  "license": "MIT",
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "matter",
    "roborock",
    "roborock vacuum",
    "robot vacuum",
    "vacuum cleaner",
    "supports-hap",
    "supports-matter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasict/homebridge-roborock-vacuum.git"
  },
  "bugs": {
    "url": "https://github.com/tasict/homebridge-roborock-vacuum/issues"
  },
  "homepage": "https://tasict.github.io/homebridge-roborock-vacuum/",
  "funding": [
    {
      "type": "individual",
      "url": "https://tasict.bobaboba.me"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/tasict"
    }
  ],
  "main": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "config.schema.json",
    "dist",
    "!dist/**/*.test.*",
    "homebridge-ui",
    "roborockLib",
    "!roborockLib/data",
    "!roborockLib/lib/sniffing",
    "!roborockLib/test.js"
  ],
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": "^18.20.4 || ^20.15.1 || ^22 || ^24"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm install --include=dev && npm run build",
    "postpublish": "npm run clean",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/roborockLib/"
    ]
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.1.2",
    "axios": "^1.13.4",
    "binary-parser": "^2.3.0",
    "crc-32": "^1.2.2",
    "mqtt": "^5.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@babel/core": "7.24.8",
    "@babel/preset-env": "7.24.8",
    "@babel/preset-typescript": "7.24.7",
    "@types/jest": "30.0.0",
    "@types/node": "20.14.10",
    "@types/semver": "7.5.8",
    "babel-jest": "30.2.0",
    "homebridge": "^2.1.0",
    "jest": "30.2.0",
    "prettier": "3.3.2",
    "rimraf": "6.0.1",
    "typescript": "5.5.3"
  }
}
